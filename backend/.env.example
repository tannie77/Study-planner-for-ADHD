# Optional: defaults to port 5000 and backend/data/studyvella.sqlite
PORT=5000
DB_PATH=./data/studyvella.sqlite

# Set these to enable Razorpay subscriptions.
# APP_URL must be the public HTTPS origin of this app, without a trailing slash.
APP_URL=https://your-domain.example
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Required before selling Pro. Use the real business name and a working inbox.
BUSINESS_NAME=Studyvella
SUPPORT_EMAIL=
SUPPORT_PHONE=
BUSINESS_ADDRESS=
# Choose 7-day-first-charge or no-refunds after reviewing the published policy.
REFUND_POLICY=7-day-first-charge

# Password recovery emails. Verify the sender domain with Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
